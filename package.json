{
  "name": "print-toys",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "next build",
    "check": "pnpm lint && pnpm typecheck && pnpm format",
    "dev": "next dev --hostname 0.0.0.0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix --type-aware .",
    "lint:check": "oxlint --type-aware .",
    "postinstall": "prisma generate",
    "prisma:studio": "prisma studio",
    "start": "next start -p 3030",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "~1.9.0",
    "@point-of-sale/receipt-printer-encoder": "~4.0.1",
    "@prisma/client": "~7.10.1",
    "canvas": "~3.2.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "domhandler": "^5.0.3",
    "dotenv": "~18.0.9",
    "marked": "~18.1.2",
    "next": "~16.4.3",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "shadcn": "~4.23.0",
    "tailwind-merge": "~3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "usb": "~2.19.1"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@tailwindcss/postcss": "~4.3.3",
    "@types/node": "~26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "autoprefixer": "~10.6.2",
    "oxfmt": "~0.75.0",
    "oxlint": "~1.90.0",
    "oxlint-tsgolint": "~7.0.2005",
    "postcss": "~8.5.32",
    "prisma": "~7.10.1",
    "tailwindcss": "~4.3.3",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@10.34.4"
}
